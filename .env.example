# Exact Docker image version (latest for first deploy; SHA tags for CD)
IMAGE_TAG=latest

NODE_ENV=production
PORT=5000

JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# Frontend origin for CORS (must match the public app URL)
CLIENT_URL=http://102.202.208.195:3000

# MySQL (service name "database" inside Docker Compose)
DB_HOST=database
DB_PORT=3306
DB_NAME=umuriroreport
DB_USER=umuriroreport
DB_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_A_LONG_RANDOM_ROOT_PASSWORD
